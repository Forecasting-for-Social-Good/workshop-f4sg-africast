{
  "text-color": "#1F2A36",
  "background-color": null,
  "line-number-color": "#8A939C",
  "line-number-background-color": null,
  "text-styles": {
    "Other": { "text-color": "#B5570F" },
    "Attribute": { "text-color": "#434A5C", "italic": true },
    "SpecialVariable": { "text-color": "#434A5C" },
    "SpecialString": { "text-color": "#4E7A27" },
    "Annotation": { "text-color": "#8A939C", "italic": true },
    "Function": { "text-color": "#2E5F8E", "bold": true },
    "String": { "text-color": "#4E7A27" },
    "ControlFlow": { "text-color": "#2E5F8E", "bold": true },
    "Operator": { "text-color": "#B5570F" },
    "Error": { "text-color": "#A40000", "bold": true },
    "BaseN": { "text-color": "#7A4A9C" },
    "Alert": { "text-color": "#A40000", "bold": true },
    "Variable": { "text-color": "#1F2A36" },
    "BuiltIn": { "text-color": "#2E5F8E" },
    "Extension": { "text-color": "#2E5F8E" },
    "Preprocessor": { "text-color": "#8A939C", "italic": true },
    "Information": { "text-color": "#8A939C", "italic": true },
    "VerbatimString": { "text-color": "#4E7A27" },
    "Warning": { "text-color": "#B5570F", "bold": true, "italic": true },
    "Documentation": { "text-color": "#8A939C", "italic": true },
    "Import": { "text-color": "#2E5F8E" },
    "Char": { "text-color": "#4E7A27" },
    "DataType": { "text-color": "#2E5F8E" },
    "Float": { "text-color": "#7A4A9C" },
    "Comment": { "text-color": "#8A939C", "italic": true },
    "CommentVar": { "text-color": "#8A939C", "bold": true, "italic": true },
    "Constant": { "text-color": "#7A4A9C" },
    "SpecialChar": { "text-color": "#B5570F" },
    "DecVal": { "text-color": "#7A4A9C" },
    "Keyword": { "text-color": "#2E5F8E", "bold": true }
  }
}
